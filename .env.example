# Gemini CLI OpenAI Node.js Worker - Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Background Token Refresh
BACKGROUND_TOKEN_REFRESH=true
BACKGROUND_TOKEN_REFRESH_INTERVAL=3600000
BACKGROUND_TOKEN_REFRESH_BUFFER=300000

# Account Rotation
RANDOM_ACCOUNT_SELECTION=true

# Logging Configuration
SHOW_DETAILED_LOGS=false

# Gemini Configuration
ENABLE_FAKE_THINKING=false
ENABLE_REAL_THINKING=false
STREAM_THINKING_AS_CONTENT=false

AUTH_TYPE=oauth-personal
